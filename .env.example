# =============================================================================
# MonitorGov360 — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA comite o arquivo .env.local no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE
# Obtenha em: https://supabase.com/dashboard → Settings → API
# -----------------------------------------------------------------------------

# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (segura para expor no cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (somente no servidor — NUNCA exponha no cliente)
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# FIREBASE — Cloud Messaging (Push Notifications)
# Obtenha em: https://console.firebase.google.com → Configurações do Projeto
# -----------------------------------------------------------------------------

# Configuração pública do Firebase (lado cliente)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Chave VAPID para Web Push (Firebase)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Credencial de conta de serviço Firebase (somente servidor, formato JSON em base64)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------

# URL base da aplicação (sem barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente: development | staging | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# OPCIONAL — Analytics / Monitoramento
# -----------------------------------------------------------------------------

# Sentry DSN para monitoramento de erros (opcional)
NEXT_PUBLIC_SENTRY_DSN=

# ID de rastreamento do Google Analytics (opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
